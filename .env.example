# community_service configuration. Copy to `.env` for local development; the
# process reads the environment directly in every other environment.

# HTTP listener port (default 8080).
PORT=8080

# PostgreSQL connection string. Required.
DATABASE_URL=postgres://community:community@localhost:5432/community_service?sslmode=disable

# Kafka bootstrap brokers, comma separated. Required.
KAFKA_BROKERS=localhost:9092

# Optional SASL/TLS settings for a secured broker.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TLS_ENABLED=false

# Consumer group of moderation_events (default community_service).
KAFKA_CONSUMER_GROUP=community_service

# Identity access-token verification. Required: issuer, audience and a JWKS.
IDENTITY_ISSUER=https://identity.example.test
IDENTITY_AUDIENCE=community_service
IDENTITY_JWKS_PATH=/etc/community_service/identity-jwks.json
IDENTITY_JWKS=

# Per-edge service token of the /internal/* oracle surface. Required.
INTERNAL_SERVICE_TOKEN=local-development-service-token

# Seconds allowed for draining on SIGTERM (default 20).
SHUTDOWN_TIMEOUT_SECONDS=20

# debug | info | warn | error (default info).
LOG_LEVEL=info
